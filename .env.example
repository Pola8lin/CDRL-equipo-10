# Configuración local sintética. Nunca reemplaces estos valores por secretos reales en Git.
POSTGRES_HOST=localhost
POSTGRES_DB=cdrl
POSTGRES_USER=cdrl_dev
POSTGRES_PASSWORD=cdrl_dev_only
POSTGRES_PORT=5432
DYNAMODB_PORT=8000
AWS_REGION=us-east-1

CDRL_MIGRATOR_PASSWORD=cdrl_migrator_local_only
CDRL_WRITER_PASSWORD=cdrl_writer_local_only
CDRL_READER_PASSWORD=cdrl_reader_local_only
CDRL_OPERATOR_PASSWORD=cdrl_operator_local_only


# Firestore: ruta local al archivo de credenciales autorizado.
# Configurar solo si se utiliza un archivo de cuenta de servicio.
FIREBASE_CREDENTIALS_PATH=
